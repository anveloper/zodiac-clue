{
  "name": "zodiac-clue",
  "version": "0.1.0",
  "private": true,
  "description": "Web multiplayer Clue-style deduction game (NAN 2026). Monorepo: Colyseus server + Phaser client.",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:server": "pnpm --filter @zodiac-clue/server dev",
    "dev:client": "pnpm --filter @zodiac-clue/client dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "verify": "node scripts/verify.mjs",
    "verify:quick": "node scripts/verify.mjs --quick",
    "verify:json": "node scripts/verify.mjs --json",
    "verify:print": "node scripts/verify-print.mjs",
    "verify:print:json": "node scripts/verify-print.mjs --json",
    "gate:bundle": "node scripts/gate-bundle-budget.mjs",
    "gate:sim": "node scripts/sim-balance.mjs --gate",
    "gate:gpu": "node scripts/gate-gpu-baseline.mjs",
    "gate:docs": "node scripts/gate-docs-consistency.mjs",
    "gate:screen": "node scripts/gate-screen.mjs",
    "gate:screen:json": "node scripts/gate-screen.mjs --json",
    "gate:screen:selftest": "node scripts/gate-screen.mjs --self-test",
    "eval:narrator": "node scripts/eval-narrator.mjs",
    "eval:narrator:json": "node scripts/eval-narrator.mjs --json",
    "eval:narrator:live": "node scripts/eval-narrator.mjs --live",
    "clean": "pnpm -r exec rm -rf dist node_modules && rm -rf node_modules"
  }
}
